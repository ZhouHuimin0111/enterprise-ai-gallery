# Local demonstration only. Copy to .env; never commit real credentials.
DB_PASSWORD=local-demo-password
MYSQL_ROOT_PASSWORD=local-root-password
REDIS_PASSWORD=local-redis-password
BOOTSTRAP_ADMIN_PASSWORD=DemoAdmin2026!
DEMO_SEED=true
STORAGE_MODE=local
AI_MODE=demo
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Private bucket required. Change STORAGE_MODE to cos to use these.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# Change AI_MODE to dashscope. Use the endpoint matching your workspace and region.
# e.g. https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=wanx2.1-t2i-turbo
ENABLE_API_DOCS=true
HIDE_API_DOCS=false
